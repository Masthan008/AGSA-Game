# ADSA Quest API
NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adsa_quest?schema=public"

# Clerk backend keys — use values from the same Clerk application as the web app.
CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"

# Comma-separated web/mobile development origins. Never use * in production.
ALLOWED_ORIGINS="http://localhost:5173,capacitor://localhost,https://localhost"

# Optional one-time bootstrap list. Production authorization is stored server-side;
# this list must never make an unconfigured deployment permissive.
ADMIN_EMAILS="teacher@example.edu"
