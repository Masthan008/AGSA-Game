datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id // Clerk User ID or Guest UUID
  email         String?  @unique
  username      String
  imageUrl      String?
  role          String   @default("student") // student | admin
  xp            Int      @default(0)
  streakDays    Int      @default(1)
  levelUnlocked Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  progress    LevelProgress[]
  bookmarks   Bookmark[]
  notes       UserNote[]
  completions PuzzleCompletion[]
  tasks       Task[]
}

model PuzzleCompletion {
  id          String   @id @default(uuid())
  userId      String
  puzzleId    String
  puzzleType  String   @default("quiz") // quiz | flashcard
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, puzzleId])
}

model LevelProgress {
  id          String   @id @default(uuid())
  userId      String
  levelId     String
  stars       Int      @default(0)
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
}

model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  topicId    String
  topicTitle String
  note       String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserNote {
  id         String   @id @default(uuid())
  userId     String
  topicId    String
  topicTitle String
  content    String
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Tasks = levels assigned to a student by the admin (teacher). A task is
// auto-completed when the student records progress on that level.
model Task {
  id          String    @id @default(uuid())
  userId      String
  levelId     String
  assignedAt  DateTime  @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
}
