datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id // Clerk User ID or Guest UUID
  email           String?   @unique
  username        String
  imageUrl        String?
  role            String    @default("student") // student | admin
  xp              Int       @default(0)
  streakDays      Int       @default(1)
  longestStreak   Int       @default(1)
  lastActiveAt    DateTime?
  timezone        String    @default("UTC")
  guestMigratedAt DateTime?
  levelUnlocked   Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  progress                LevelProgress[]
  bookmarks               Bookmark[]
  notes                   UserNote[]
  completions             PuzzleCompletion[]
  tasks                   Task[]                @relation("StudentTasks")
  assignedTasks           Task[]                @relation("AssignedTasks")
  achievements            UserAchievement[]
  classroomsTeaching      Classroom[]           @relation("TeacherClassrooms")
  classroomMemberships    ClassroomMember[]
  quizAttempts            QuizAttempt[]
  flashcardReviews        FlashcardReview[]
  idempotencyRecords      IdempotencyRecord[]
  auditEvents             AuditLog[]            @relation("AuditActor")
  treeAssignmentsReceived TreeAssignment[]      @relation("TreeAssignmentStudent")
  treeAssignmentsCreated  TreeAssignment[]      @relation("TreeAssignmentTeacher")
  treeSubmissions         TreeSubmission[]
  lessonCheckpoints       LessonCheckpoint[]
  skillMastery            StudentSkillMastery[]
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  userId       String
  key          String
  operation    String
  responseJson Json?
  statusCode   Int      @default(200)
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model FlashcardReview {
  id           String   @id @default(uuid())
  userId       String
  cardId       String
  intervalDays Int      @default(0)
  ease         Float    @default(2.5)
  nextReviewAt DateTime @default(now())
  reviewedAt   DateTime @default(now())
  lastRating   String   @default("new")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, nextReviewAt])
}

model QuizAttempt {
  id            String   @id @default(uuid())
  userId        String
  puzzleId      String
  levelId       String
  selectedIndex Int
  correct       Boolean
  hintUsed      Boolean  @default(false)
  attemptedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, attemptedAt])
}

model UserAchievement {
  id         String   @id @default(uuid())
  userId     String
  badgeKey   String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
}

model PuzzleCompletion {
  id          String   @id @default(uuid())
  userId      String
  puzzleId    String
  puzzleType  String   @default("quiz") // quiz | flashcard
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, puzzleId])
}

model LevelProgress {
  id          String   @id @default(uuid())
  userId      String
  levelId     String
  stars       Int      @default(0)
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
}

model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  topicId    String
  topicTitle String
  note       String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserNote {
  id         String   @id @default(uuid())
  userId     String
  topicId    String
  topicTitle String
  content    String
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Tasks = levels assigned to a student by the admin (teacher). A task is
// auto-completed when the student records progress on that level.
model Task {
  id           String    @id @default(uuid())
  userId       String
  levelId      String
  assignedAt   DateTime  @default(now())
  completedAt  DateTime?
  assignedById String?
  classroomId  String?
  dueAt        DateTime?
  instructions String?

  user       User       @relation("StudentTasks", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?      @relation("AssignedTasks", fields: [assignedById], references: [id], onDelete: SetNull)
  classroom  Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)

  @@unique([userId, levelId])
}

model Classroom {
  id        String   @id @default(uuid())
  name      String
  joinCode  String   @unique
  teacherId String
  createdAt DateTime @default(now())

  teacher         User              @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  members         ClassroomMember[]
  tasks           Task[]
  treeAssignments TreeAssignment[]
}

model TreeAssignment {
  id            String    @id @default(uuid())
  studentId     String
  teacherId     String
  classroomId   String?
  topic         String
  operation     String
  initialState  Json
  targetState   Json?
  btreeDegree   Int?
  difficulty    String    @default("beginner")
  instructions  String?
  dueAt         DateTime?
  maxAttempts   Int       @default(3)
  hintsAllowed  Boolean   @default(true)
  requiredScore Int       @default(70)
  xpReward      Int       @default(40)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student     User             @relation("TreeAssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher     User             @relation("TreeAssignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  classroom   Classroom?       @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  submissions TreeSubmission[]

  @@index([studentId, dueAt])
  @@index([teacherId, createdAt])
  @@index([classroomId])
}

model TreeSubmission {
  id            String    @id @default(uuid())
  assignmentId  String
  studentId     String
  status        String    @default("in_progress")
  finalState    Json?
  score         Int       @default(0)
  hintsUsed     Int       @default(0)
  durationMs    Int       @default(0)
  attemptNumber Int       @default(1)
  feedback      Json?
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?

  assignment TreeAssignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  steps      TreeOperationStep[]

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([studentId, submittedAt])
}

model TreeOperationStep {
  id           String   @id @default(uuid())
  submissionId String
  sequence     Int
  operation    String
  payload      Json
  stateAfter   Json
  correct      Boolean?
  skillKey     String?
  createdAt    DateTime @default(now())

  submission TreeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, sequence])
}

model LessonCheckpoint {
  id            String   @id @default(uuid())
  userId        String
  topic         String
  checkpointKey String
  completedAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic, checkpointKey])
}

model StudentSkillMastery {
  id        String   @id @default(uuid())
  userId    String
  topic     String
  skillKey  String
  attempts  Int      @default(0)
  correct   Int      @default(0)
  hintsUsed Int      @default(0)
  mastery   Float    @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic, skillKey])
  @@index([userId, mastery])
}

model ClassroomMember {
  id          String   @id @default(uuid())
  classroomId String
  userId      String
  joinedAt    DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
}
